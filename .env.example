# ===== AI =====
# Danh sách nhà cung cấp AI theo thứ tự ưu tiên, cách nhau bằng dấu phẩy. Provider đầu hết lượt / lỗi thì app
# tự chuyển sang provider sau; hết cả thì dùng câu thoại mẫu offline (văn phòng không bao giờ đứng hình).
# Để trống AI_PROVIDERS (và OPENAI_API_KEY) => chạy OFFLINE hoàn toàn: câu thoại mẫu, 0 đồng, xem thử giao diện.
AI_PROVIDERS=gemini,groq
# balanced = cảnh thường xen kẽ các nguồn, nghiêng về nguồn còn nhiều quota ngày; priority = đúng thứ tự trên
AI_ROUTING=balanced

# Mỗi provider TÊN có bộ biến AI_<TÊN>_*:
#   AI_<TÊN>_API_KEY            key (để trống => provider bị bỏ qua, có cảnh báo lúc khởi động)
#   AI_<TÊN>_MODEL              tên model
#   AI_<TÊN>_BASE_URL           endpoint tương thích OpenAI (gemini / groq có sẵn mặc định, openai để trống)
#   AI_<TÊN>_RPM / _RPD / _TPD  giới hạn tự áp: lượt / phút, lượt / ngày, token / ngày (trống = không giới hạn)
#   AI_<TÊN>_PRICE_INPUT_PER_M / _PRICE_CACHED_INPUT_PER_M / _PRICE_OUTPUT_PER_M  giá USD / 1M token (mặc định 0 = miễn phí)
#   AI_<TÊN>_REASONING_EFFORT   chỉ cho model suy luận: minimal | low | medium | high
#   AI_<TÊN>_TIER               normal (mặc định) | strong = ưu tiên cho việc quan trọng (đuổi việc, phỏng vấn, bản tin, ứng viên)
#   AI_<TÊN>_JSON               schema (mặc định, tự hạ xuống json_object khi model không nhận) | object
#   AI_<TÊN>_LABEL              tên hiển thị trên chip AI (mặc định Gemini / Groq / OpenAI / TÊN)

# --- Gemini (miễn phí) — lấy key tại https://aistudio.google.com/apikey ---
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.5-flash-lite
AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Giới hạn gói miễn phí (ước lượng): số lượt gọi mỗi ngày — chạm mức này app tự chuyển sang Groq tới khi Google reset
# (0h giờ Pacific = 14h mùa hè / 15h mùa đông giờ Việt Nam)
AI_GEMINI_RPD=500
AI_GEMINI_RPM=10
# việc quan trọng (phỏng vấn, xét nhân sự, bản tin) ưu tiên Gemini
AI_GEMINI_TIER=strong

# --- Groq (miễn phí) — lấy key tại https://console.groq.com/keys ---
# Model Groq free đã đo 2026-11-01: openai/gpt-oss-120b (mặc định, JSON ổn định) · qwen/qwen3.8-27b (tiếng Việt tự nhiên hơn nhưng trần 1.000 token ra/phút → cần AI_GROQ_REASONING=false, AI_GROQ_MAX_OUTPUT_TOKENS=900)
AI_GROQ_API_KEY=
AI_GROQ_MODEL=openai/gpt-oss-120b
AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
# Giới hạn gói miễn phí (theo model, ước lượng): lượt / ngày và token / ngày
AI_GROQ_RPD=1000
AI_GROQ_TPD=200000
# Chỉ cho model suy luận (gpt-oss, qwen3): low | medium | high
AI_GROQ_REASONING_EFFORT=low
# Groq free (đo 2026-11-01): 8.000 token/phút, 200.000 token/ngày → tối đa 2 lượt/phút, trần 1.500 token ra, không gửi request > 8.000 token
AI_GROQ_RPM=2
AI_GROQ_MAX_OUTPUT_TOKENS=1500
AI_GROQ_MAX_REQUEST_TOKENS=8000
# tiếng Việt của gpt-oss hơi cứng → chỉ gánh ~1/3 phần cảnh thường khi các nguồn khác còn quota
AI_GROQ_WEIGHT=0.35

# --- OpenAI (trả tiền) — thêm "openai" vào AI_PROVIDERS nếu muốn dùng ---
# AI_OPENAI_API_KEY=sk-...
# AI_OPENAI_MODEL=gpt-4o-mini
# AI_OPENAI_TIER=strong

# Cấu hình kiểu cũ (1 nhà cung cấp) — chỉ có tác dụng khi AI_PROVIDERS để trống
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_REASONING_EFFORT=
# In prompt + phản hồi AI ra terminal (chỉ bật khi thử nghiệm)
# DEBUG_PROMPTS=1

# ===== Tiết kiệm token =====
# Trần chi phí mỗi ngày (USD, tính chung mọi provider; provider miễn phí = 0). Vượt trần: cảnh thường bị bỏ, cảnh quan trọng dùng câu mẫu offline
DAILY_BUDGET_USD=1
# Tối thiểu bao nhiêu giây thật giữa 2 lần gọi AI cho cảnh thường
MIN_SECONDS_BETWEEN_LLM=20
MAX_CONCURRENT_LLM=2
# Không có ai đang xem => không gọi AI cho cảnh thường
LLM_ONLY_WHEN_WATCHED=true
# Chế độ offline: tối thiểu bao nhiêu giây giữa 2 cảnh
OFFLINE_MIN_SECONDS=8

# Giá (USD / 1 triệu token) cho cấu hình kiểu cũ — để trống thì dùng bảng giá ước tính có sẵn theo model
PRICE_INPUT_PER_M=
PRICE_CACHED_INPUT_PER_M=
PRICE_OUTPUT_PER_M=

# ===== Thời gian =====
# compressed: thời gian nén (mặc định) | realtime: chạy theo giờ thật Việt Nam
TIME_MODE=compressed
# Số phút trong game trôi qua mỗi giây thật (0.5 => 1 ngày làm việc ~22 phút thật)
GAME_MINUTES_PER_SECOND=0.5

# ===== KPI / HR =====
# Dưới bao nhiêu % mục tiêu thì tính là "thấp"; bao nhiêu ngày thấp liên tiếp thì cảnh cáo / đuổi
KPI_LOW_RATIO=0.7
KPI_WARN_DAYS=2
KPI_FIRE_DAYS=3

# ===== Affiliate =====
# Tối thiểu bao nhiêu phút thật giữa 2 lần nhân viên nhắc sản phẩm (cảnh thường)
PRODUCT_MENTION_MIN_MINUTES=8
# Tối thiểu bao nhiêu phút THẬT giữa 2 cảnh "Khoe đồ ở phòng trưng bày" 🛍️ (luôn có chip sản phẩm). 0 = không giới hạn
SHOWROOM_SCENE_MIN_MINUTES=30

# ===== Khác =====
COMPANY_NAME=Cty TNHH VibeCorp
# Bảng điều khiển dev (tua nhanh, tạo sự kiện). Lên production: đặt false, hoặc giữ true + DEV_TOKEN (cuối file) để chỉ bạn bấm được.
DEV_PANEL=true
# Lưu trạng thái văn phòng ra file để khởi động lại không mất dữ liệu
PERSIST=true
STATE_FILE=data/state.json
PORT=3000

# ===== v3: Thời sự (nhân vật bàn tin thật từ RSS báo — docs/v3-news.md) =====
# Bật/tắt toàn bộ tính năng tin thời sự
NEWS_ENABLED=true
# Danh sách RSS "nhom|url" cách nhau bằng dấu phẩy; nhóm: the_thao, cong_nghe, game, khoa_hoc, giai_tri
# (bóng đá tự gắn nhãn phụ bong_da). Để trống = danh sách mặc định đã kiểm tra (VnExpress, Tuổi Trẻ, Thanh Niên, GameK).
NEWS_FEEDS=
# Tải lại tin mỗi bao nhiêu phút (lần đầu ~20 giây sau khi bật server)
NEWS_REFRESH_MINUTES=45
# Tối thiểu bao nhiêu phút THẬT giữa 2 cảnh "Tám chuyện thời sự" (0 = không giới hạn)
NEWS_SCENE_MIN_MINUTES=25
# Cho bàn tin giải trí nhẹ (phim, nhạc, show, gameshow, thời trang, trend)? Tin pháp lý / đời tư luôn bị chặn.
NEWS_ALLOW_SHOWBIZ=true
# Không bàn tin cũ hơn bao nhiêu ngày
NEWS_MAX_AGE_DAYS=3
# Từ / cụm từ chặn THÊM (cách nhau bằng dấu phẩy), ngoài danh sách có sẵn trong src/news/filter.ts
NEWS_BLOCKLIST=

# ===== v3: Câu chuyện tự phát triển (AI quyết định, không kịch bản) =====
# AI biên kịch: mỗi ~N phút game đề xuất 1–3 "biến" (xung đột, bug lớn, khách giận, tình bạn bí mật…)
SHOWRUNNER_ENABLED=true
SHOWRUNNER_EVERY_GAME_MINUTES=120
# Lần khởi tạo đầu: tính cách mỗi người = giá trị gốc ± 0.15 → không ai bị "đánh dấu" lười / kém từ trước
STORY_RANDOMIZE_TRAITS=true
# Tính cách trôi theo sự kiện (bị nhắc → chăm hơn, được khen → tham vọng hơn…), kẹp ±0.25 quanh gốc
STORY_TRAIT_DRIFT=true
# HR + sếp họp xét nhân sự (AI quyết: cảnh cáo / thử thách / khen / thưởng / thăng chức / cho nghỉ…) mỗi N ngày game.
# KPI_WARN_DAYS / KPI_FIRE_DAYS ở trên chỉ còn là hàng rào tối thiểu + dự phòng khi chạy offline.
HR_REVIEW_EVERY_DAYS=3

# ===== v3: Lưu trữ dài hạn =====
# Ghi mọi câu thoại / sự kiện / bản tin / quyết định nhân sự vào data/history/YYYY-MM-DD.jsonl (ngày theo giờ Việt Nam)
HISTORY_ENABLED=true
HISTORY_DIR=data/history
# Giữ bao nhiêu ngày (cũ hơn thì xoá) và sau bao nhiêu ngày thì nén gzip
HISTORY_KEEP_DAYS=180
HISTORY_GZIP_AFTER_DAYS=7

# ===== v3: Bảng dev trên production =====
# Để trống = như cũ (DEV_PANEL quyết định cho MỌI người xem). Đặt một chuỗi bí mật dài (vd: openssl rand -hex 16)
# => chỉ trình duyệt nối WebSocket với ?dev=<token> (mở trang web kèm ?dev=<token>) mới thấy / bấm được bảng dev;
# người xem khác không thấy gì. DEV_PANEL=false tắt hẳn, kể cả có token.
DEV_TOKEN=

# ---- Cloudflare Workers AI (nguồn thứ 3, free 10.000 neuron/ngày — xem README mục 3.3). Thêm ",cloudflare" vào AI_PROVIDERS.
# AI_CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# AI_CLOUDFLARE_API_KEY=
# AI_CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
# AI_CLOUDFLARE_RPM=30
# AI_CLOUDFLARE_RPD=400
# AI_CLOUDFLARE_TPD=900000
# AI_CLOUDFLARE_JSON=object
# tắt chế độ "suy nghĩ" của Gemma (không tắt: chậm gấp 3, tốn gấp 4)
# AI_CLOUDFLARE_EXTRA_JSON={"chat_template_kwargs":{"enable_thinking":false}}

# Mỗi nguồn còn có: AI_<TÊN>_PACE=true|false (giữ nhịp quota ngày), AI_<TÊN>_WEIGHT (trọng số khi balanced),
# AI_<TÊN>_REASONING=true|false, AI_<TÊN>_MAX_OUTPUT_TOKENS, AI_<TÊN>_MAX_REQUEST_TOKENS, AI_<TÊN>_EXTRA_JSON
